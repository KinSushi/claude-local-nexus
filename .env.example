# ============================================================
# Claude-Local-Nexus — modèle de configuration
#
# Copier ce fichier vers .env, puis remplacer CHAQUE valeur.
# Les valeurs ci-dessous sont des marqueurs, pas des défauts :
# elles doivent toutes être changées avant tout démarrage.
#
# .env est exclu du dépôt et ne doit jamais y entrer.
# ============================================================

# --- PostgreSQL ---------------------------------------------
# Base de la passerelle : historique de dépense, clés, sessions.
# C'est le seul volume dont le contenu ne se reconstruit pas.
POSTGRES_USER=litellm_user
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
POSTGRES_DB=litellm

# --- LiteLLM ------------------------------------------------
# Clé maîtresse de la passerelle. Elle protège l'accès à TOUS
# les modèles, y compris ceux facturés au token.
#
# En générer une plutôt que d'en inventer une :
#   PowerShell : "sk-" + [guid]::NewGuid().ToString("N")
#   Bash       : echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=REMPLACER_PAR_UNE_CLE_GENEREE

# --- Anthropic ----------------------------------------------
# Crédits API, facturés au token. Distincts de l'abonnement
# claude.ai : voir docs/pont-local-abonnement.md.
# Laisser vide désactive simplement le plan Anthropic.
ANTHROPIC_API_KEY=sk-ant-REMPLACER

# --- Ollama Cloud -------------------------------------------
# https://ollama.com/settings/keys
# Laisser vide désactive le plan cloud ; le local continue.
OLLAMA_CLOUD_API_KEY=REMPLACER

# --- Redis --------------------------------------------------
# Cache d'exécution. Facultatif : vide signifie sans mot de passe,
# ce qui convient tant que Redis n'écoute que sur le réseau Docker.
REDIS_PASSWORD=

# --- Langfuse (observabilité, facultatif) -------------------
# Sans ces clés, la plateforme fonctionne mais ne trace rien.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Profil Docker ------------------------------------------
# embedded : Ollama tourne dans la pile (défaut).
# vide     : Ollama est attendu sur l'hôte, et seuls LiteLLM,
#            PostgreSQL et Redis restent conteneurisés — le
#            strict nécessaire, car eux seuls détiennent quelque
#            chose qui ne se retélécharge pas.
COMPOSE_PROFILES=embedded
