# ============================================================
# FICHIER D'EXEMPLE .ENV - Claude-Local-Nexus
# Copiez ce fichier vers .env et remplissez les valeurs.
# Ne committez jamais le vrai .env.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=litellm_user
POSTGRES_PASSWORD=superuser
POSTGRES_DB=litellm

# --- LiteLLM ---
LITELLM_MASTER_KEY=ma-cle-tres-secrete-2025

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-votre_clé

# --- Ollama Cloud ---
OLLAMA_CLOUD_API_KEY=votre_clé_ollama_cloud

# --- Redis (optionnel) ---
REDIS_PASSWORD=

# --- Langfuse Cloud ---
LANGFUSE_PUBLIC_KEY=pk-lf-votre_clé
LANGFUSE_SECRET_KEY=sk-lf-votre_clé
LANGFUSE_HOST=https://cloud.langfuse.com