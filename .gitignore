# Secrets
.env

# Artefacts d'exploitation
backups/
logs/
.nexus/
*.log
*.tar.gz


# Python
__pycache__/
*.pyc

# Worktrees temporaires des agents : ce sont des depots imbriques,
# reconstruits a la demande et sans valeur en dehors de leur session.
.claude/worktrees/

# Candidats d'ecriture atomique. Un echec en laisse un sur le disque ;
# il est ecrase au prochain essai et ne doit jamais etre confondu avec
# le fichier reel, ni encombrer `git status` au moment ou l'on diagnostique.
*.candidat
*.avant-patch

# Diffs temporaires ecrits par l'outillage de validation, pour que le
# fenetrage MAP-REDUCE s'applique. Un residu ne doit jamais encombrer
# `git status` au moment ou l'on diagnostique.
temp_diff_*.txt
releve_tous.txt
claims.json
audit_ps.json
audit_ps_err.txt
lot_ps.json
batir_lot_ps.py
backlog.json
correctifs.json
appliquer.py
lot_essai.json
sortie_incr.jsonl
essai_err.txt
claims_ps.json

# Documentation Python officielle, absorbee du depot voisin (136 Mo).
# Reference locale, jamais du code de ce depot : elle ne part pas a la vitrine.
references/python_libs_docs/
.nexus/index_doc_libs.tsv
lint_ps.json
outils_voisins.json
candidats_voisins.json
appliquer_ps.py
lint_js.json
lint_js_brut.json
lot_outillage.json
brouillon_outillage.txt
references/shell_docs/
references/lecons/
# Livres COMMERCIAUX empruntes PAR COPIE a un depot voisin. Jamais
# publies : ce depot est une vitrine PUBLIQUE, et ce qui part sur
# GitHub reste indexe meme efface ensuite. L'ignorance est posee
# AVANT la copie, jamais apres.
references/livres/
patchs.jsonl
reparations.jsonl
lot_patchs.json
lot_reparations.json
cat.json
capacites.jsonl
modalite.jsonl
lot_capacites.json
lot_modalite.json

# Etats DERIVES, regeneres a chaque rituel : les versionner salit l arbre
# a chaque tour et bloque la vitrine, qui exige un arbre propre. Mesure :
# trois publications refusees le 2026-09-01 a cause de STATE.md.
PROGRESS.MD

# Etat DERIVE, regenere par nexus_state.py toutes les 10 min par NexusTraque.
# Versionne, il salissait l arbre en permanence et BLOQUAIT la vitrine —
# constate trois fois le 2026-09-01. Or la vitrine est la seule sauvegarde.
# Meme arbitrage que PROGRESS.MD : un etat derive ne se versionne pas.
rituels/STATE.md
v15*.json

# Les corpus pesent 59 Mo et n'ont rien a faire dans l'historique.
# Mais leur POINTEUR pese 5 Ko et c'est le seul artefact qui dit a un
# autre projet CE QUI EXISTE et CE QUI MANQUE. L'ignorer rendait le
# partage impossible : mesure du 2026-09-02, aucun des deux pointeurs
# n'etait suivi, y compris celui que la session voisine nous citait.
!references/*/_POINTEUR_CORPUS.md

# Corpus pre-mache absorbe depuis le depot voisin : 118 Mo, et des noms de
# fichiers qui depassent la limite de git (erreur << Filename too long >>).
# Meme regle que references/livres/ : la matiere reste hors historique, seul
# son pointeur est suivi par l exception plus bas.
references/livres_texte/
references/python_libs_docs_eamt5/

# Doc pre-machee CALIBREE pour petits modeles locaux : fragment moyen ~6 000
# octets, contre ~24 Ko pour le calibre cloud. Un 0,5B tronque en silence
# au-dela de ~10 Ko : deux calibres sont necessaires, pas un.
references/CODE_ENZO/
references/CODE_LIVRES/

# Index d embeddings : sortie de calcul, jamais du code. Ecrit par erreur dans
# nexus/ sans le point le 2026-09-02 — QUATRIEME fois que ce point se perd.
nexus/
