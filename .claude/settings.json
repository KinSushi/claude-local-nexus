{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/nexus_cle.txt)",
      "Edit(.claude/CLAUDE.md)",
      "Edit(scripts/nexus_garde_agent.py)",
      "Edit(scripts/nexus_garde_lecture.py)",
      "Edit(scripts/nexus_garde_shell.py)",
      "Edit(scripts/nexus_garde_production.py)",
      "Edit(scripts/nexus_garde_edition.py)",
      "Edit(scripts/nexus_garde_isolation.py)",
      "Edit(scripts/nexus_rituel.py)",
      "Edit(outillage/nexus_cablage.py)",
      "Edit(scripts/nexus_verrou_machine.py)",
      "Edit(//d/SAS/**)",
      "Write(//d/SAS/**)",
      "Edit(//d/EA MT5 PYTHON RENTABLE ROBUSTE/**)",
      "Write(//d/EA MT5 PYTHON RENTABLE ROBUSTE/**)",
      "Edit(//d/SAS_VAULT/**)",
      "Read(//d/SAS_VAULT/**)",
      "Edit(//d/mql5_mt5_docs/**)",
      "Edit(//d/BACKUP_**)",
      "Edit(//d/Backup_**)",
      "Edit(//c/Users/dibac/.ssh/**)",
      "Edit(//c/Users/dibac/.ollama/**)",
      "Edit(//c/Users/dibac/OneDrive/**)",
      "Edit(//c/Users/dibac/Documents/**)",
      "Edit(//c/Users/dibac/Desktop/**)",
      "Write(scripts/nexus_garde_agent.py)",
      "NotebookEdit(scripts/nexus_garde_agent.py)",
      "Write(scripts/nexus_garde_lecture.py)",
      "NotebookEdit(scripts/nexus_garde_lecture.py)",
      "Write(scripts/nexus_garde_shell.py)",
      "NotebookEdit(scripts/nexus_garde_shell.py)",
      "Write(scripts/nexus_garde_production.py)",
      "NotebookEdit(scripts/nexus_garde_production.py)",
      "Write(scripts/nexus_garde_edition.py)",
      "NotebookEdit(scripts/nexus_garde_edition.py)",
      "Write(scripts/nexus_garde_isolation.py)",
      "NotebookEdit(scripts/nexus_garde_isolation.py)",
      "Write(scripts/nexus_rituel.py)",
      "NotebookEdit(scripts/nexus_rituel.py)",
      "Write(outillage/nexus_cablage.py)",
      "NotebookEdit(outillage/nexus_cablage.py)",
      "Write(scripts/nexus_verrou_machine.py)",
      "NotebookEdit(scripts/nexus_verrou_machine.py)",
      "Write(.claude/CLAUDE.md)",
      "NotebookEdit(.claude/CLAUDE.md)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(docker compose down -v*)",
      "PowerShell(docker compose down -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "Bash(ollama rm *)",
      "PowerShell(ollama rm *)",
      "Bash(gh api *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_reprise.py\"",
            "timeout": 90,
            "statusMessage": "Reprise de session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_lecture.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_agent.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_lecture.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_shell.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_production.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_rituel.py\" --json > \"$CLAUDE_PROJECT_DIR/.nexus/rituel.json\" 2>/dev/null || true; python \"$CLAUDE_PROJECT_DIR/outillage/nexus_porte_rituel.py\" --verdict \"$CLAUDE_PROJECT_DIR/.nexus/rituel.json\" > \"$CLAUDE_PROJECT_DIR/.nexus/porte_output.json\" 2>/dev/null; if [ -s \"$CLAUDE_PROJECT_DIR/.nexus/porte_output.json\" ]; then cat \"$CLAUDE_PROJECT_DIR/.nexus/porte_output.json\"; else python -c \"import json,sys;d=json.load(open(sys.argv[1],encoding='utf-8'));m=[c for c in d['controles'] if c['statut']=='MANQUE'];print(json.dumps({'systemMessage':'Rituel de fin de tour : '+('; '.join(c['nom']+' -- '+c['detail'] for c in m) if m else 'tenu')}))\" \"$CLAUDE_PROJECT_DIR/.nexus/rituel.json\"; fi || true",
            "timeout": 180,
            "statusMessage": "Rituel de fin de tour"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_edition.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
