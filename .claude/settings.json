{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/nexus_cle.txt)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(docker compose down -v*)",
      "PowerShell(docker compose down -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "Bash(ollama rm *)",
      "PowerShell(ollama rm *)",
      "Bash(gh api *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_reprise.py\"",
            "timeout": 90,
            "statusMessage": "Reprise de session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_garde_agent.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/nexus_rituel.py\" --json > \"$CLAUDE_PROJECT_DIR/.nexus/rituel.json\" 2>&1; python -c \"import json,sys;d=json.load(open(sys.argv[1],encoding='utf-8'));m=[c for c in d['controles'] if c['statut']=='MANQUE'];print(json.dumps({'systemMessage':'Rituel de fin de tour : '+('; '.join(c['nom']+' -- '+c['detail'] for c in m) if m else 'tenu')}))\" \"$CLAUDE_PROJECT_DIR/.nexus/rituel.json\" 2>/dev/null || true",
            "timeout": 180,
            "statusMessage": "Rituel de fin de tour"
          }
        ]
      }
    ]
  }
}
