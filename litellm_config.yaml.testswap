# ============================================================
# 10. GENERAL SETTINGS
# ============================================================

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY

  # Intervalle relevé, pas choisi au hasard : à 30 s, les journaux
  # montraient `background_health_check_cycle_duration_exceeded_interval`
  # avec des cycles de 60 s. Autrement dit, la sonde tournait en
  # permanence et chargeait les modèles en boucle dans Ollama — sur un
  # hôte CPU, elle volait la machine au travail réel.
  #
  # Avec 40 modèles locaux et un cycle d'une minute, 900 s ramènent la
  # sonde à quelques pour cent d'occupation. Une panne est détectée en
  # quinze minutes au pire ; le coût de la détecter en trente secondes
  # était de ne plus rien pouvoir calculer d'autre.
  background_health_checks: true
  health_check_interval: 900
  enable_health_check_routing: true
  health_check_ignore_transient_errors: true

# ============================================================
# 11. LITELLM SETTINGS
# ============================================================

litellm_settings:
  drop_params: true
  set_verbose: false

  cache: true
  # Cache exact uniquement. Le cache sémantique a été retiré : sur des
  # étapes d'agent et des appels d'outils, deux prompts « proches » n'ont
  # pas la même réponse correcte (§27).
  cache_params:
    type: redis
    host: redis
    port: 6379
    ttl: 3600

  # Observabilité sans contenu.
  #
  # Les callbacks s'appliquent a TOUTES les requetes, y compris celles des
  # 41 modeles locaux. Sans ce reglage, chaque prompt et chaque reponse --
  # y compris les fenetres de nexus_context, les fichiers de
  # nexus_summarize et les images base64 de nexus_vision -- partaient vers
  # cloud.langfuse.com. La promesse « aucune donnee ne quitte la machine »
  # etait donc fausse pour le plan local, alors meme que les outils
  # l'annoncaient.
  #
  # turn_off_message_logging conserve ce dont l'observabilite a besoin --
  # modele, fournisseur, latence, tokens, cout, replis, cache, erreurs
  # (§28) -- et retire le contenu, dont elle n'a jamais eu besoin.
  turn_off_message_logging: true

  success_callback:
    - langfuse

  failure_callback:
    - langfuse

  request_timeout: 180

# ============================================================
# 12. OLLAMA — VARIABLES D'ENVIRONNEMENT
# ============================================================
# Définir côté service/processus Ollama, pas dans ce YAML LiteLLM.
#
# PowerShell :
#
#   $env:OLLAMA_MAX_LOADED_MODELS=3
#   $env:OLLAMA_NUM_PARALLEL=2
#   $env:OLLAMA_KEEP_ALIVE="15m"
#   $env:OLLAMA_FLASH_ATTENTION=1
#   $env:OLLAMA_HOST="127.0.0.1:11434"
#   $env:OLLAMA_MAX_QUEUE=512
#   $env:OLLAMA_KV_CACHE_TYPE="q8_0"
#
# Si Ollama est dans Docker, privilégier la section environment:
# du compose.yaml plutôt que ces variables PowerShell.
#
# Note :
#   OLLAMA_HOST=127.0.0.1:11434 est correct uniquement si Ollama est
#   accessible depuis le même hôte. Si LiteLLM est dans un autre
#   conteneur, conserver un réseau Docker commun et utiliser le nom
#   de service "ollama" dans api_base.
# ============================================================
