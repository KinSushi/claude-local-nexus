# ============================================================
# LITELLM — CONFIGURATION PLATEFORME IA HYBRIDE
# ============================================================
# Version corrigée à partir de la configuration fournie.
#
# Principes :
#   - aucun "dummy pool" : les fallbacks pointent vers de vrais modèles
#   - adaptive router configuré selon le schéma LiteLLM actuel
#   - adaptive_router_preferences ajoutées aux modèles candidats
#   - coûts Anthropic corrigés
#   - coûts placés dans litellm_params pour le calcul de l'adaptive router
#   - paramètres de routage canoniques conservés
#   - limites de sortie appliquées via max_tokens/num_predict
#   - secrets externalisés via variables d'environnement
#   - suppression des blocs "routing_groups" hétérogènes, qui ne créent pas
#     un pool cross-model ; utiliser les routers adaptatifs ci-dessous
#
# IMPORTANT :
#   - OLLAMA_CLOUD_API_KEY doit être défini si les modèles :cloud sont utilisés.
#   - ANTHROPIC_API_KEY doit être défini pour les modèles Claude.
#   - REDIS doit être joignable sous le nom Docker "redis".
#   - LANGFUSE_* doit être configuré si les callbacks Langfuse restent actifs.
# ============================================================

# ============================================================
# NEXUS-ROUTER-VERSION: rdb210b95d0
# Version de la politique de routage. Elle change des que les
# pools, les chaines de fallback ou les seuils materiels
# changent — donc des qu'une meme requete pourrait etre servie
# par un autre modele. Sans elle, un resultat d'hier ne peut
# pas etre rattache aux regles qui l'ont produit.
# ============================================================

model_list:

  # ==========================================================
  # 1. ANTHROPIC — CLAUDE
  # ==========================================================

  - model_name: claude-fable-5
    litellm_params:
      model: anthropic/claude-fable-5
      api_key: os.environ/ANTHROPIC_API_KEY
      input_cost_per_token: 0.000010
      output_cost_per_token: 0.000050
      max_tokens: 128000
    model_info:
      max_input_tokens: 1000000
      description: "Claude Fable 5 — adaptive thinking, 1M context, 128K max output"
      adaptive_router_preferences:
        quality_tier: 3
        strengths:
          - analytical_reasoning
          - technical_design
          - code_generation
          - code_understanding

  - model_name: claude-opus-5
    litellm_params:
      model: anthropic/claude-opus-5
      api_key: os.environ/ANTHROPIC_API_KEY
      input_cost_per_token: 0.000005
      output_cost_per_token: 0.000025
      max_tokens: 128000
    model_info:
      max_input_tokens: 1000000
      description: "Claude Opus 5 — reasoning, agentic workloads, 1M context, 128K max output"
      adaptive_router_preferences:
        quality_tier: 3
        strengths:
          - analytical_reasoning
          - technical_design
          - code_generation
          - code_understanding

  - model_name: claude-sonnet-5
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
      input_cost_per_token: 0.000002
      output_cost_per_token: 0.000010
      max_tokens: 128000
    model_info:
      max_input_tokens: 1000000
      description: "Claude Sonnet 5 — vitesse/intelligence, 1M context, 128K max output"
      adaptive_router_preferences:
        quality_tier: 3
        strengths:
          - code_generation
          - code_understanding
          - technical_design
          - analytical_reasoning
          - general

  - model_name: claude-haiku-4-5
    litellm_params:
      model: anthropic/claude-haiku-4-5
      api_key: os.environ/ANTHROPIC_API_KEY
      input_cost_per_token: 0.000001
      output_cost_per_token: 0.000005
      max_tokens: 64000
    model_info:
      max_input_tokens: 200000
      description: "Claude Haiku 4.5 — rapide, 200K context, 64K max output"
      adaptive_router_preferences:
        quality_tier: 2
        strengths:
          - general
          - factual_lookup
          - code_understanding

  # ==========================================================
  # 2. LOCAL — OLLAMA
  # ==========================================================
  # num_ctx reste volontairement conservateur à 8K / 32K pour la
  # machine locale de 62 Go RAM. Les modèles peuvent supporter
  # davantage, mais la capacité du modèle n'implique pas qu'il soit
  # rationnel de réserver tout le contexte localement.

  # ---- GLM 4.7 Flash ----------------------------------------
  - model_name: glm-4.7-flash-local
    litellm_params:
      model: ollama_chat/glm-4.7-flash
      api_base: http://host.docker.internal:11434
      litellm_health_check: true
      num_ctx: 32768
      num_predict: 4096
    model_info:
      max_input_tokens: 32768
      description: "GLM-4.7-Flash — 30B-A3B MoE"
      adaptive_router_preferences:
        quality_tier: 2
        strengths:
          - code_generation
          - code_understanding
          - technical_design
          - analytical_reasoning

  # ---- Releve locale : remplacer l'orchestrateur -------------
  # Profil dedie au cas ou l'abonnement Claude expire ou que son quota
  # est atteint. Claude Code est gourmand en contexte : Ollama recommande
  # au moins 64K pour cette classe de charge, et 8K rendrait la relève
  # inutilisable des la premiere lecture de depot.
  #
  # Dimensionnement mesure, pas estime : glm-4.7-flash charge a 65536
  # occupe 23 Go (19 Go de poids + ~4 Go de cache KV), releve par
  # `ollama ps`. C'est le meilleur compromis disponible ici — un MoE
  # 30B-A3B dont peu de parametres sont actifs, donc utilisable sur CPU,
  # et qui supporte l'appel d'outils indispensable a la boucle agentique.
  #
  # Volontairement hors des pools : ce n'est pas un candidat de routage
  # mais un role, choisi explicitement par Set-ClaudeModel.ps1 -Mode Local.
  - model_name: releve-locale
    litellm_params:
      model: ollama_chat/glm-4.7-flash
      api_base: http://host.docker.internal:11434
      litellm_health_check: true
      num_ctx: 65536
      num_predict: 8192
    model_info:
      max_input_tokens: 65536
      description: "Releve locale — 64K de contexte, prend la suite sans abonnement"
      nexus_pool: false

  # ---- Gemma 4 31B ------------------------------------------
  - model_name: gemma4-31b-local
