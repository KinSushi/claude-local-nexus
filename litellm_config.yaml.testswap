  # <<< AUTOGEN:CLOUD_MODELS

  # ==========================================================
  # 7. ROUTEURS ADAPTATIFS
  # ==========================================================
  #
  # NOTE ARCHITECTURAL :
  #   Les anciens local-pool/cloud-pool basés sur ollama/dummy ont
  #   été supprimés. Ils ne constituaient pas de vrais pools.
  #
  #   Les trois routeurs ci-dessous sont de vrais modèles LiteLLM
  #   auto_router/adaptive_router.
  #
  #   Le routeur global reste volontairement à quality=1.0 / cost=0.0 :
  #   LiteLLM doit disposer de vrais coûts pour le terme cost. Les coûts
  #   Ollama Cloud ne sont pas déclarés ici faute de tarif token unifié
  #   garanti dans la configuration fournie. Quand tu disposeras d'un
  #   pricing stable pour ces modèles, ajoute input_cost_per_token dans
  #   leurs litellm_params et tu pourras réactiver un poids cost > 0.
  #
  #   Claude n'est pas inclus dans le routeur global volontairement :
  #   les conversations Claude avec thinking peuvent contenir des blocs
  #   de raisonnement qui ne doivent pas être routés arbitrairement vers
  #   un autre provider. Utiliser le routeur Anthropic dédié pour Claude.

  - model_name: adaptive-router-local
    litellm_params:
      model: auto_router/adaptive_router
      # >>> AUTOGEN:LOCAL_POOL
      adaptive_router_default_model: qwen3-coder-30b-local
      adaptive_router_config:
        available_models:
          - qwen3-coder-30b-local
          - qwen2.5-coder-32b-local
          - llama3.2-3b-local
          - ultime-recourse-local
      # <<< AUTOGEN:LOCAL_POOL
        weights:
          quality: 1.0
          cost: 0.0
    model_info:
      description: "Adaptive Router — pool local textuel"

  - model_name: adaptive-router-cloud
    litellm_params:
      model: auto_router/adaptive_router
      adaptive_router_default_model: qwen3.5-397b-cloud
      adaptive_router_config:
        available_models:
          # >>> AUTOGEN:CLOUD_POOL_CLOUD
          - qwen3.5-397b-cloud
          - deepseek-v4-pro-0813-cloud
          - kimi-k3-cloud
          - glm-5.3-cloud
          - mistral-large-3-675b-cloud
          - minimax-m3-cloud
          - nemotron-3-ultra-cloud
          - kimi-k2.7-code-cloud
          - glm-5.2-cloud
          - deepseek-v4-flash-0731-cloud
          - gpt-oss-120b-cloud
          - nemotron-3-super-cloud
          - glm-5.3-flash-cloud
          - minimax-m2.7-cloud
          - kimi-k2.6-cloud
          - glm-5.1-cloud
          - gpt-oss-20b-cloud
          - nemotron-3-nano-30b-cloud
          - gemma4-31b-cloud
          # <<< AUTOGEN:CLOUD_POOL_CLOUD
        weights:
          quality: 1.0
          cost: 0.0
    model_info:
      description: "Adaptive Router — pool Ollama Cloud"

  - model_name: adaptive-router-anthropic
    litellm_params:
      model: auto_router/adaptive_router
      adaptive_router_default_model: claude-sonnet-5
      adaptive_router_config:
        available_models:
          - claude-fable-5
          - claude-opus-5
          - claude-sonnet-5
          - claude-haiku-4-5
        weights:
          quality: 0.8
          cost: 0.2
    model_info:
      description: "Adaptive Router — pool Anthropic/Claude"

  - model_name: adaptive-router
    litellm_params:
      model: auto_router/adaptive_router
      # >>> AUTOGEN:GLOBAL_POOL
      adaptive_router_default_model: qwen3-coder-30b-local
      adaptive_router_config:
        available_models:
          - qwen3-coder-30b-local
          - qwen2.5-coder-32b-local
          - llama3.2-3b-local
          - ultime-recourse-local
      # <<< AUTOGEN:GLOBAL_POOL
          # >>> AUTOGEN:CLOUD_POOL_GLOBAL
          - qwen3.5-397b-cloud
          - deepseek-v4-pro-0813-cloud
          - kimi-k3-cloud
          - glm-5.3-cloud
          - mistral-large-3-675b-cloud
          - minimax-m3-cloud
          - nemotron-3-ultra-cloud
          - kimi-k2.7-code-cloud
          - glm-5.2-cloud
          - deepseek-v4-flash-0731-cloud
          - gpt-oss-120b-cloud
          - nemotron-3-super-cloud
          - glm-5.3-flash-cloud
          - minimax-m2.7-cloud
          - kimi-k2.6-cloud
          - glm-5.1-cloud
          - gpt-oss-20b-cloud
          - nemotron-3-nano-30b-cloud
          - gemma4-31b-cloud
          # <<< AUTOGEN:CLOUD_POOL_GLOBAL
        weights:
          quality: 1.0
          cost: 0.0
    model_info:
      description: "Point d'entrée global — adaptive routing local + Ollama Cloud"


# ============================================================
# 8. ROUTER SETTINGS
# ============================================================
# Le client doit demander "adaptive-router" pour utiliser le routeur global.
# Il n'existe pas ici de clé "default_model" non standard à la racine.

router_settings:
  routing_strategy: usage-based-routing-v2
  enable_pre_call_checks: true
  num_retries: 2
